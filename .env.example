# VinilArt Sport — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores necessários.
# NUNCA comites o ficheiro .env para o repositório.

# =============================================================
# PROCESSAMENTO DE IMAGEM PREMIUM
# =============================================================
# Chave de API para remoção de fundo Premium.
# Sem esta chave, o personalizador usa processamento local (heurístico).
# Sugestão: https://www.remove.bg/api
REMOVE_BG_API_KEY=

# =============================================================
# LINK VinilArt PRINCIPAL
# =============================================================
# URL do site principal VinilArt (ex: https://vinilart.pt)
# Usado no header e footer para o link "Voltar à VinilArt".
# Deixa vazio para omitir o link.
VITE_VINILART_MAIN_URL=
